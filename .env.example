# Copy to .env.local and fill in. Never commit .env.local.
#
# The first two come from the Supabase dashboard (Project Settings > API Keys).
# The next two are secrets you generate yourself, once, and keep:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Must match the row in private.app_secrets where name = 'feedback_write_secret'.
FEEDBACK_WRITE_SECRET=

# Peppers the submitter-token and IP hashes. Changing it resets de-duplication.
FEEDBACK_HASH_SECRET=

# Optional, and only affects the share card. The site's public origin, used to
# make the Open Graph image URL absolute — a crawler is handed a URL, not a
# path. On Vercel this is unnecessary: the project's production domain is picked
# up automatically. Set it when the council moves to a domain of its own.
# NEXT_PUBLIC_SITE_URL=https://plan.adducity.gov.mv
